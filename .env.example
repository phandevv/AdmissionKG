# ============================================================
# AdmissionKG - Environment Variables Example
# Sao chép file này thành .env và điền giá trị thực
# ============================================================

# Server Ports
BACKEND_PORT=8080
FRONTEND_PORT=3001

# PostgreSQL Configuration
POSTGRES_HOST=localhost          # local dev: localhost | docker: postgres (container name)
POSTGRES_PORT=5432
POSTGRES_DB=admissions_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Neo4j Aura Cloud (thay bằng credentials của bạn)
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# DeepSeek LLM API (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-<your-deepseek-api-key>

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (phân cách bằng dấu phẩy)
# Docker: trình duyệt truy cập qua localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost,http://127.0.0.1:3001
